# Copiar a .env y completar. .env NO se versiona.

DTE_ENV=dev

# --- Seguridad ---------------------------------------------------------------
# 32 bytes en base64. Generar con:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Si se pierde, los certificados y CAF cifrados con ella son irrecuperables.
# Nunca en la base de datos, nunca en el repositorio. Ver README.
DTE_MASTER_KEY=

# Versión con la que se cifra lo nuevo. Sube al rotar la llave maestra.
DTE_MASTER_KEY_VERSION=1

# Llaves anteriores, para seguir leyendo lo cifrado antes de una rotación.
# Formato JSON: {"1": "<base64 de la llave vieja>"}
DTE_MASTER_KEYS_ANTERIORES={}

# Compartida con el backend que consume este servicio.
DTE_INTERNAL_API_KEY=

# --- Base de datos -----------------------------------------------------------
# El rol de aplicación NO tiene BYPASSRLS; lo crea la migración inicial.
POSTGRES_PASSWORD=postgres
DTE_APP_DB_PASSWORD=dte_app
DTE_DATABASE_URL=postgresql+asyncpg://dte_app:dte_app@localhost:5433/dte
DTE_DATABASE_OWNER_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dte

# --- Infraestructura ---------------------------------------------------------
DTE_REDIS_URL=redis://localhost:6379/0
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
DTE_S3_ENDPOINT_URL=http://localhost:9000
DTE_S3_ACCESS_KEY=minioadmin
DTE_S3_SECRET_KEY=minioadmin
DTE_S3_BUCKET=dte

# --- Observabilidad ----------------------------------------------------------
DTE_SENTRY_DSN=

# --- Negocio -----------------------------------------------------------------
# Folios restantes bajo los cuales se pide un CAF nuevo.
DTE_FOLIO_UMBRAL_ALERTA=100
# Envíos simultáneos al SII por RUT emisor.
DTE_SII_CONCURRENCIA_POR_RUT=2

# --- Solo para el diagnóstico de certificación (app/scripts/certificacion.py) --
# Clave del .pfx de pruebas. Nunca en el repositorio ni en el chat.
DTE_CERT_PASSWORD=

# --- Solo para `certificacion enviar` (documento de prueba al SII de certificación)
# Fecha de la resolución de certificación del SII (AAAA-MM-DD).
DTE_FCH_RESOL=
# Datos del emisor tal como están registrados en el SII.
DTE_EMISOR_GIRO=
DTE_EMISOR_ACTECO=
DTE_EMISOR_DIRECCION=
DTE_EMISOR_COMUNA=
DTE_EMISOR_CIUDAD=
