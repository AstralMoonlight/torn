# ── Torn — Variables de Entorno ──────────────────
# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# Entorno de ejecución: development | staging | production
# En staging/production la app no arranca sin SECRET_KEY.
TORN_ENV=development

# Clave de firma de los JWT. OBLIGATORIA fuera de desarrollo.
# Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Vigencia del token de acceso, en minutos (por defecto 720 = 12 h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Base de datos ────────────────────────────────
TORN_DB_USER=postgres
TORN_DB_PASSWORD=postgres
TORN_DB_HOST=localhost
TORN_DB_PORT=5432
TORN_DB_NAME=torn_db

# ── API ──────────────────────────────────────────
# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío se usan los localhost de desarrollo.
TORN_CORS_ORIGINS=

# Crear tablas con SQLAlchemy al arrancar (1/0). El esquema real lo gobierna
# Alembic; déjalo en 0 en despliegues serios.
TORN_AUTO_CREATE_TABLES=1
