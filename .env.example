# ── Torn - Variables de Entorno ──────────────────
# Copia este archivo a .env y ajusta los valores. .env NO se versiona.

# Entorno de ejecución: development | staging | production
# En staging/production la app no arranca sin SECRET_KEY.
TORN_ENV=development

# Clave de firma de los JWT. OBLIGATORIA fuera de desarrollo.
# Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Vigencia del token de acceso, en minutos (por defecto 720 = 12 h).
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── Base de datos ────────────────────────────────
TORN_DB_USER=postgres
TORN_DB_PASSWORD=postgres
TORN_DB_HOST=localhost
TORN_DB_PORT=5432
TORN_DB_NAME=torn_db

# ── API ──────────────────────────────────────────
# Orígenes permitidos por CORS, separados por coma.
# Si se deja vacío se usan los localhost de desarrollo.
TORN_CORS_ORIGINS=

# Crear tablas con SQLAlchemy al arrancar (1/0). El esquema real lo gobierna
# Alembic; déjalo en 0 en despliegues serios.
TORN_AUTO_CREATE_TABLES=1

# ── Pool de conexiones ───────────────────────────────
# Cada petición con inquilino usa 2 conexiones (#38). Cuadra pool_size +
# max_overflow con el max_connections de PostgreSQL (100 por defecto),
# multiplicado por el número de instancias del backend: con una sola
# instancia, 30+40=70 deja 30 conexiones de margen para psql/migraciones y
# soporta ~35 peticiones concurrentes con inquilino antes de encolar.
TORN_DB_POOL_SIZE=30
TORN_DB_MAX_OVERFLOW=40
TORN_DB_POOL_TIMEOUT=30

# ── Facturación electrónica (dte-torn) ───────────────
# Folios, CAF, firma y envío al SII viven en el microservicio dte-torn/.
# Sin TORN_DTE_URL las ventas se rechazan con 503 (no se emite sin folio).
# Desde el compose del backend, usar http://host.docker.internal:8001.
TORN_DTE_URL=http://localhost:8001
# Debe ser igual a DTE_INTERNAL_API_KEY en dte-torn/.env
TORN_DTE_API_KEY=
